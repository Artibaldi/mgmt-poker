# Скопировать в .env (в git не попадает) или указать готовый файл: POKER_ENV=/path/to/.env
JIRA_URL=https://jira.example.org
JIRA_PROJECT_KEY=PROJ
JIRA_USERNAME=login
JIRA_PASSWORD=secret

