{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Колода «Управленческий покер»",
  "type": "object",
  "required": ["meta", "cards"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "person", "period"],
      "properties": {
        "id": {"type": "string", "description": "Уникальный id колоды; ключ сохранения партии в браузере. Например IvanovII_2026-06"},
        "person": {"type": "string", "description": "Кого оцениваем (имя для заголовка)"},
        "role": {"type": "string", "description": "Роль/направление"},
        "period": {"type": "string", "description": "Период, например «июнь 2026» или 2026-06"},
        "players": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2,
                    "description": "Игроки по умолчанию: [оценивает со стороны, самооценка]"},
        "suits": {"type": "object", "description": "Переопределить названия мастей",
                  "additionalProperties": {"type": "string"}},
        "sources": {"type": "array", "items": {"type": "string"}, "description": "Откуда факты (для досье)"}
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "suit", "competence", "marker", "question"],
        "properties": {
          "id": {"type": ["integer", "string"]},
          "suit": {"enum": ["♠", "♥", "♦", "♣"],
                   "description": "♠ владение и методология, ♥ люди, ♦ коммуникация и стык, ♣ самоорганизация и эскалация"},
          "competence": {"type": "string"},
          "marker": {"enum": ["strength", "growth", "disputed", "question"],
                     "description": "Гипотеза руководителя; в игре видна только после вскрытия. question — карта-вопрос без оценки"},
          "date": {"type": "string", "description": "Когда был эпизод, например 04.06 или 18.06 и 29.06"},
          "context": {"type": "string", "description": "Где: встреча, задача"},
          "fact": {"type": "string", "description": "Наблюдаемый факт без оценочных слов. Обязателен, кроме question"},
          "question": {"type": "string", "description": "Вопрос о компетенции; для question — вопрос на стол"},
          "source": {"type": "string", "description": "Проверяемый источник: ключи задач, саммари встречи"}
        }
      }
    }
  }
}
